{
  "name": "openchamber-shardx",
  "version": "2.0.0",
  "private": true,
  "description": "ShardX matrix extension for OpenChamber: 250 fixed matrix slots on 127.0.0.1:19884, egress-aligned profiles on ports 24001-24250, CDP takeover of already-running browsers, rotation freeze barriers and five MCP tools",
  "license": "MIT",
  "main": "service/main.js",
  "bin": {
    "openchamber-shardx-service": "service/main.js",
    "openchamber-shardx-mcp": "mcp/server.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wbi35772/openchamber-shardx.git"
  },
  "homepage": "https://github.com/wbi35772/openchamber-shardx#readme",
  "bugs": {
    "url": "https://github.com/wbi35772/openchamber-shardx/issues"
  },
  "keywords": [
    "openchamber",
    "extension",
    "shardx",
    "fingerprint-browser",
    "matrix",
    "egress",
    "mcp",
    "cdp"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node service/main.js",
    "service": "node service/main.js",
    "mcp": "node mcp/server.js",
    "mcp:sse": "node mcp/server.js --sse",
    "check": "node --check core/contract.js && node --check core/store-lock.js && node --check core/host-bridge.js && node --check core/profile-store.js && node --check lib/ws.js && node --check lib/scheduler.js && node --check lib/http-client.js && node --check lib/egress-client.js && node --check lib/shardx-client.js && node --check lib/cdp-runner.js && node --check lib/slot-manager.js && node --check service/main.js && node --check mcp/server.js && node --check panel/main.js && node --check tests/shardx-matrix.test.js",
    "test": "node --test tests/shardx-matrix.test.js"
  },
  "optionalDependencies": {
    "playwright-core": "^1.49.0"
  },
  "openchamber": {
    "apiVersion": 1,
    "displayName": "ShardX Matrix",
    "engines": {
      "openchamber": ">=2.5.0"
    },
    "contributes": {
      "panel": {
        "id": "shardx-matrix",
        "name": "ShardX Matrix",
        "icon": "icon.svg",
        "entry": "panel/index.html"
      },
      "page": true,
      "service": {
        "entry": "service/main.js",
        "runtime": "host",
        "keepRunning": true
      },
      "tools": [
        {
          "match": "mcp.shardx-matrix.shardx_slot_launch",
          "name": "启动矩阵槽位",
          "icon": "play-circle-line"
        },
        {
          "match": "mcp.shardx-matrix.shardx_page_observe",
          "name": "观测页面",
          "icon": "eye-line"
        },
        {
          "match": "mcp.shardx-matrix.shardx_page_act",
          "name": "页面动作",
          "icon": "cursor-line"
        },
        {
          "match": "mcp.shardx-matrix.shardx_task_run",
          "name": "执行任务序列",
          "icon": "play-list-line"
        },
        {
          "match": "mcp.shardx-matrix.shardx_slot_close",
          "name": "休眠矩阵槽位",
          "icon": "shut-down-line"
        }
      ]
    }
  }
}
